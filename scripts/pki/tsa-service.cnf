[ tsa ]
default_tsa = tsa_config

[ tsa_config ]
serial = ${ENV::PQC2PA_TSA_SERIAL_FILE}
signer_cert = ${ENV::PQC2PA_TSA_CERT_PATH}
signer_key = ${ENV::PQC2PA_TSA_PRIVATE_KEY_PATH}
certs = ${ENV::PQC2PA_ROOT_CA_CERT_PATH}

signer_digest = sha256
default_policy = 1.3.6.1.4.1.55555.1.1
digests = sha256, sha384, sha512, sha3-256

accuracy = secs:1
ordering = yes
tsa_name = yes
ess_cert_id_chain = yes
ess_cert_id_alg = sha256
clock_precision_digits = 0