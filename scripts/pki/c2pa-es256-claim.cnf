[ req ]
prompt = no
distinguished_name = c2pa_es256_dn
req_extensions = c2pa_es256_request_extensions

[ c2pa_es256_dn ]
C = KR
O = PQ-C2PA Research
OU = Claim Signing Service
CN = PQ-C2PA ES256 Claim Signer

[ c2pa_es256_request_extensions ]
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature
extendedKeyUsage = emailProtection,1.3.6.1.5.5.7.3.36,1.3.6.1.4.1.62558.2.1
subjectKeyIdentifier = hash

[ c2pa_es256_certificate_extensions ]
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature
extendedKeyUsage = emailProtection,1.3.6.1.5.5.7.3.36,1.3.6.1.4.1.62558.2.1
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer