# C2PA Claim을 ML-DSA-65로 서명할 Leaf 인증서의 신원과 용도를 정의

[ req ]
prompt = no
distinguished_name = claim_signer_dn
req_extensions = claim_signer_request_extensions

[ claim_signer_dn ]
C = KR
O = PQ-C2PA Research
OU = Claim Signing Service
CN = PQ-C2PA Claim Signer

[ claim_signer_request_extensions ]
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature
extendedKeyUsage = 1.3.6.1.4.1.62558.2.1
subjectKeyIdentifier = hash

[ claim_signer_certificate_extensions ]
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature
extendedKeyUsage = 1.3.6.1.4.1.62558.2.1
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer